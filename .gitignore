# Terraform
**/.terraform/*
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# NOTE: *.tfvars is ignored above by default (tfvars commonly hold secrets),
# but this repo's tracked tfvars files contain no secrets (only project id,
# region, network sizing, etc.) and are required by the Jenkins pipeline's
# `terraform plan/apply -var-file=...`, so they are explicitly un-ignored:
!terraform.tfvars
!environments/**/*.tfvars

# Keys / certificates
*.pem
*.key
*.p12

# Terraform plan/apply artifacts produced by Jenkins
tfplan.out
tfplan.log
tfapply.log
tfdestroy.log
tfoutputs.log

# Service account keys / credentials
*.json
!package.json
.gcp/
gcp-sa-key
gcp-sa-key.json
*sa-key*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
